CONFIG_GPIO=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_USB_DEVICE_STACK_NEXT=y
# No hardware-ID provider yet; omit the USB serial-number descriptor.
CONFIG_HWINFO=n
CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT=y
CONFIG_CDC_ACM_SERIAL_VID=0x0ac8
CONFIG_CDC_ACM_SERIAL_PID=0xbb91
CONFIG_CDC_ACM_SERIAL_MANUFACTURER_STRING="CWbeat"
CONFIG_CDC_ACM_SERIAL_PRODUCT_STRING="CWbeat console"
CONFIG_CDC_ACM_SERIAL_SELF_POWERED=y
CONFIG_BUILD_OUTPUT_BIN=y
