diff --git a/tests/drivers/timer/cortex_m_systick/src/main.c b/tests/drivers/timer/cortex_m_systick/src/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..527001011d30f547f3de5f51a155d32997954c6f
--- /dev/null
+++ b/tests/drivers/timer/cortex_m_systick/src/main.c
@@ -0,0 +1,184 @@
+/*
+ * SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/ztest.h>
+#include <zephyr/init.h>
+#include <zephyr/drivers/timer/system_timer.h>
+#include <zephyr/sys/clock.h>
+#include <cmsis_core.h>
+#include <zephyr/irq.h>
+#include <zephyr/sys/util.h>
+#include <zephyr/drivers/counter.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/drivers/timer/system_timer_lpm.h>
+
+/* Compile a separate copy of the driver against register storage. This permits
+ * wrapped epochs and pending elapsed cycles without changing the test kernel's
+ * clock. The real SysTick continues to schedule the ztest runner.
+ */
+static SysTick_Type test_systick;
+static SCB_Type test_scb;
+static unsigned int test_clock_hz;
+static uint32_t first_load;
+static bool capture_load;
+
+static SysTick_Type *test_systick_get(void)
+{
+	if (capture_load && (test_systick.LOAD != 0U)) {
+		first_load = test_systick.LOAD;
+		capture_load = false;
+	}
+	return &test_systick;
+}
+
+#undef SysTick
+#define SysTick test_systick_get()
+#undef SCB
+#define SCB (&test_scb)
+#undef NVIC_SetPriority
+#define NVIC_SetPriority(irq, priority) do { } while (false)
+#undef SYS_INIT
+#define SYS_INIT(fn, level, priority)
+#define sys_clock_isr test_sys_clock_isr
+#define sys_clock_idle_enter test_sys_clock_idle_enter
+#define sys_clock_idle_exit test_sys_clock_idle_exit
+#define sys_clock_disable test_sys_clock_disable
+#define sys_clock_set_timeout test_sys_clock_set_timeout
+#define sys_clock_elapsed test_sys_clock_elapsed
+#define sys_clock_cycle_get_32 test_sys_clock_cycle_get_32
+#define sys_clock_cycle_get_64 test_sys_clock_cycle_get_64
+#define z_sys_clock_hw_cycles_per_sec_update test_clock_update
+#define z_clock_hw_cycles_per_sec test_clock_hz
+#undef sys_clock_hw_cycles_per_sec
+#define sys_clock_hw_cycles_per_sec() test_clock_hz
+
+#include "cortex_m_systick.c"
+
+static void seed_clock(uint32_t hz, uint64_t ticks, uint32_t unannounced_cycles)
+{
+	memset(&test_systick, 0, sizeof(test_systick));
+	memset(&test_scb, 0, sizeof(test_scb));
+	test_clock_hz = hz;
+	timer_core_cyc_per_tick = hz / CONFIG_SYS_CLOCK_TICKS_PER_SEC;
+	timer_core_max_span_ticks = TIMER_CORE_MAX_UNANNOUNCED_CYCLES /
+				    TIMER_CORE_CYC_PER_TICK;
+	timer_core_last_tick = ticks;
+	timer_core_last_cycle = ticks * TIMER_CORE_CYC_PER_TICK;
+	timer_core_last_elapsed = 0U;
+	timer_core_armed_deadline = UINT64_MAX;
+	timer_core_catchup = false;
+	cycle_count = (uint32_t)(timer_core_last_cycle + unannounced_cycles);
+	overflow_cyc = 0U;
+	last_load = TIMER_CORE_CYC_PER_TICK * 10U;
+	test_systick.LOAD = last_load - 1U;
+	test_systick.CTRL = SysTick_CTRL_ENABLE_Msk | SysTick_CTRL_TICKINT_Msk;
+	capture_load = false;
+}
+
+static void check_clock(uint64_t ticks, uint32_t delta)
+{
+	uint64_t baseline = ticks * TIMER_CORE_CYC_PER_TICK;
+	k_spinlock_key_t key = sys_clock_lock();
+	uint32_t elapsed_ticks = test_sys_clock_elapsed();
+
+	sys_clock_unlock(key);
+	zassert_equal(timer_core_last_tick, ticks, "announce tick changed");
+	zassert_equal(timer_core_last_cycle, baseline, "announce epoch changed");
+	zassert_equal(test_sys_clock_cycle_get_64(), baseline + delta,
+		      "counter lost its epoch during rate change");
+	zassert_equal(elapsed_ticks, delta / TIMER_CORE_CYC_PER_TICK,
+		      "frequency change fabricated elapsed ticks");
+	zassert_equal(timer_core_max_span_ticks,
+		      TIMER_CORE_MAX_UNANNOUNCED_CYCLES / TIMER_CORE_CYC_PER_TICK,
+		      "maximum scheduling span kept the old frequency");
+}
+
+ZTEST(systick_frequency, test_initial_reload_uses_runtime_rate)
+{
+	seed_clock(64000000U, 0U, 0U);
+	timer_core_cyc_per_tick = 0U;
+	last_load = 0U;
+	test_systick.LOAD = 0U;
+	first_load = 0U;
+	capture_load = true;
+
+	zassert_ok(sys_clock_driver_init());
+	zassert_equal(first_load, 6399U, "first reload used an uninitialized tick cache");
+	zassert_equal(timer_core_last_tick, 0U);
+}
+
+ZTEST(systick_frequency, test_fractional_rates_preserve_wrapped_epoch)
+{
+	const uint64_t ticks = 671100U;
+
+	/* The 64 MHz counter has wrapped; its low word is close to zero. */
+	seed_clock(64000000U, ticks, 32000U);
+	test_clock_update(26000000U);
+	check_clock(ticks, 13000U);
+	test_clock_update(192000000U);
+	check_clock(ticks, 96000U);
+
+	/* Repeated transitions must not accumulate fabricated wraps. */
+	for (uint32_t i = 0U; i < 100U; i++) {
+		test_clock_update(64000000U);
+		check_clock(ticks, 32000U);
+		test_clock_update(26000000U);
+		check_clock(ticks, 13000U);
+		test_clock_update(192000000U);
+		check_clock(ticks, 96000U);
+	}
+}
+
+ZTEST(systick_frequency, test_long_epoch_and_fractional_cycles_per_tick)
+{
+	const uint64_t ticks = 100000000000ULL;
+
+	/* The full epoch times the new rate would overflow uint64_t. The old
+	 * frequency is also not an integer multiple of the kernel tick rate.
+	 */
+	seed_clock(39075000U, ticks, 39075U);
+	test_clock_update(192000000U);
+	check_clock(ticks, 192000U);
+	for (uint32_t i = 0U; i < 100U; i++) {
+		test_clock_update(39075000U);
+		check_clock(ticks, 39075U);
+		test_clock_update(192000000U);
+		check_clock(ticks, 192000U);
+	}
+}
+
+ZTEST(systick_frequency, test_pending_elapsed_is_counted_once)
+{
+	const uint64_t ticks = 671100U;
+
+	seed_clock(64000000U, ticks, 12800U);
+	/* Two accumulated ticks, a captured ten-tick wrap, and three ticks in
+	 * the current period must remain fifteen ticks after the update.
+	 */
+	overflow_cyc = last_load;
+	test_systick.VAL = last_load - 19200U;
+	test_scb.ICSR = SCB_ICSR_PENDSTSET_Msk;
+	test_clock_update(26000000U);
+	check_clock(ticks, 39000U);
+	zassert_equal(overflow_cyc, 0U);
+	zassert_equal(test_scb.ICSR, SCB_ICSR_PENDSTSET_Msk, "pending IRQ was cleared");
+	test_clock_update(192000000U);
+	check_clock(ticks, 288000U);
+}
+
+ZTEST(systick_frequency, test_stopped_timer_preserves_epoch)
+{
+	const uint64_t ticks = 671100U;
+
+	seed_clock(64000000U, ticks, 32000U);
+	last_load = TIMER_STOPPED;
+	test_systick.CTRL = 0U;
+	test_clock_update(26000000U);
+	zassert_equal(last_load, TIMER_STOPPED);
+	zassert_equal(test_systick.CTRL, 0U);
+	check_clock(ticks, 13000U);
+}
+
+ZTEST_SUITE(systick_frequency, NULL, NULL, NULL, NULL, NULL);
