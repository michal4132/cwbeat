diff --git a/tests/subsys/usb/cdc_acm/src/main.c b/tests/subsys/usb/cdc_acm/src/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..413d0f404d48a01f6523df93b1f74815ed2706a6
--- /dev/null
+++ b/tests/subsys/usb/cdc_acm/src/main.c
@@ -0,0 +1,325 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* SPDX-FileCopyrightText: Copyright The Zephyr Project Contributors */
+#include <zephyr/kernel.h>
+#include <zephyr/ztest.h>
+#include <zephyr/drivers/uart.h>
+#include <zephyr/drivers/usb/udc.h>
+#include <zephyr/usb/usbd.h>
+
+static int work_submit(struct k_work *work);
+static int work_schedule(struct k_work_delayable *work, k_timeout_t delay);
+static int ep_enqueue(struct usbd_class_data *const c_data, struct net_buf *const buf);
+
+/* No CDC devicetree instance is needed: construct the class below with real
+ * net_buf pools, UART callbacks and FIFO operations. Replace only endpoint
+ * submission and work scheduling so a callback loop fails instead of hanging
+ * the system workqueue. Supply the class defaults normally enabled by its DT
+ * instance; no class logging is required for these tests.
+ */
+#define CONFIG_USBD_CDC_ACM_LOG_LEVEL 0
+#define CONFIG_USBD_CDC_ACM_TX_DELAY_MS 100
+#define k_work_submit work_submit
+#define k_work_schedule work_schedule
+#define usbd_ep_enqueue ep_enqueue
+#include "class/usbd_cdc_acm.c"
+#undef k_work_submit
+#undef k_work_schedule
+#undef usbd_ep_enqueue
+
+#define BULK_IN 0x82U
+#define BULK_OUT 0x02U
+#define BUFFER_COUNT 4U
+#define BUFFER_SIZE 64U
+#define WORK_LIMIT 32U
+
+UDC_BUF_POOL_DEFINE(tx_pool, BUFFER_COUNT, BUFFER_SIZE, sizeof(struct udc_buf_info), NULL);
+UDC_BUF_POOL_DEFINE(rx_pool, BUFFER_COUNT, BUFFER_SIZE, sizeof(struct udc_buf_info), NULL);
+
+static struct k_fifo rx_bufs;
+static struct cdc_acm_uart_data uart_data;
+static struct usbd_context context;
+static struct usbd_class_data class_data;
+static struct usbd_cdc_acm_desc descriptors = {
+	.if0_int_ep.bEndpointAddress = 0x81U,
+	.if1_in_ep.bEndpointAddress = BULK_IN,
+	.if1_out_ep.bEndpointAddress = BULK_OUT,
+};
+static const struct cdc_acm_uart_config uart_config = {
+	.c_data = &class_data,
+	.desc = &descriptors,
+};
+static const struct device uart_dev = {
+	.name = "test_cdc_acm",
+	.config = &uart_config,
+	.data = &uart_data,
+	.api = &cdc_acm_uart_api,
+};
+static struct {
+	struct k_work *work[3];
+	uint32_t work_count;
+	uint32_t callbacks;
+	uint32_t tx_bytes;
+	uint32_t rx_bytes;
+	uint32_t tx_pending;
+	uint32_t enqueued_in;
+	uint32_t enqueued_out;
+	struct net_buf *submitted[2 * BUFFER_COUNT];
+	size_t submitted_count;
+} fake;
+
+static int work_submit(struct k_work *work)
+{
+	zassert_true(work == &uart_data.irq_cb_work || work == &uart_data.rx_fifo_work ||
+		     work == &uart_data.tx_fifo_work.work);
+
+	for (uint32_t i = 0; i < fake.work_count; i++) {
+		if (fake.work[i] == work) {
+			return 0;
+		}
+	}
+
+	zassert_true(fake.work_count < ARRAY_SIZE(fake.work));
+	fake.work[fake.work_count++] = work;
+
+	return 1;
+}
+
+static int work_schedule(struct k_work_delayable *work, k_timeout_t delay)
+{
+	/* Echo mitigation is complete and all exercised transfers have buffers,
+	 * so the production paths under test only schedule immediate work.
+	 */
+	zassert_true(K_TIMEOUT_EQ(delay, K_NO_WAIT));
+	return work_submit(&work->work);
+}
+
+static int ep_enqueue(struct usbd_class_data *const c_data, struct net_buf *const buf)
+{
+	zassert_equal_ptr(c_data, &class_data);
+	zassert_true(fake.submitted_count < ARRAY_SIZE(fake.submitted));
+	fake.submitted[fake.submitted_count++] = buf;
+
+	if (udc_get_buf_info(buf)->ep == BULK_IN) {
+		fake.enqueued_in++;
+	} else if (udc_get_buf_info(buf)->ep == BULK_OUT) {
+		fake.enqueued_out++;
+	} else {
+		zassert_unreachable("Unexpected endpoint");
+	}
+
+	return 0;
+}
+
+static void uart_callback(const struct device *dev, void *unused)
+{
+	static const uint8_t tx_data[8] = {'1', '2', '3', '4', '5', '6', '7', '8'};
+	uint8_t rx_data[BUFFER_SIZE];
+	int ret;
+
+	ARG_UNUSED(unused);
+	fake.callbacks++;
+	cdc_acm_irq_update(dev);
+
+	if (cdc_acm_irq_rx_ready(dev) != 0) {
+		ret = cdc_acm_fifo_read(dev, rx_data, sizeof(rx_data));
+		zassert_true(ret >= 0);
+		fake.rx_bytes += ret;
+	}
+
+	if (cdc_acm_irq_tx_ready(dev) != 0) {
+		if (fake.tx_pending != 0U) {
+			ret = cdc_acm_fifo_fill(dev, tx_data,
+					      MIN(sizeof(tx_data), fake.tx_pending));
+			zassert_true(ret >= 0);
+			fake.tx_bytes += ret;
+			fake.tx_pending -= ret;
+		} else {
+			cdc_acm_irq_tx_disable(dev);
+		}
+	}
+}
+
+static uint32_t run_work(void)
+{
+	uint32_t steps = 0U;
+
+	while (steps < WORK_LIMIT && fake.work_count != 0U) {
+		struct k_work *work = fake.work[0];
+
+		fake.work_count--;
+		memmove(fake.work, fake.work + 1, fake.work_count * sizeof(fake.work[0]));
+		work->handler(work);
+		steps++;
+	}
+
+	return steps;
+}
+
+static void before(void *unused)
+{
+	ARG_UNUSED(unused);
+	memset(&fake, 0, sizeof(fake));
+	memset(&uart_data, 0, sizeof(uart_data));
+	memset(&context, 0, sizeof(context));
+	class_data = (struct usbd_class_data){
+		.name = "test_cdc_acm",
+		.uds_ctx = &context,
+		.priv = (void *)&uart_dev,
+		.api = &usbd_cdc_acm_api,
+	};
+	k_fifo_init(&rx_bufs);
+	uart_data.dev = &uart_dev;
+	uart_data.tx_fifo.pool = &tx_pool;
+	uart_data.rx_fifo.pool = &rx_pool;
+	uart_data.rx_fifo.bufs = &rx_bufs;
+	uart_data.cb = uart_callback;
+	uart_data.line_coding = (struct cdc_acm_line_coding)CDC_ACM_DEFAULT_LINECODING;
+	zassert_ok(usbd_cdc_acm_preinit(&uart_dev));
+	zassert_not_null(uart_data.tx_fifo.current);
+	uart_data.echo_mitigated = true;
+	atomic_set_bit(&uart_data.state, CDC_ACM_CLASS_ENABLED);
+	usbd_cdc_acm_suspended(&class_data);
+}
+
+static void after(void *unused)
+{
+	struct net_buf *buf;
+
+	ARG_UNUSED(unused);
+	if (uart_data.tx_fifo.current != NULL) {
+		net_buf_unref(uart_data.tx_fifo.current);
+	}
+	while ((buf = k_fifo_get(&rx_bufs, K_NO_WAIT)) != NULL) {
+		net_buf_unref(buf);
+	}
+	for (size_t i = 0; i < fake.submitted_count; i++) {
+		net_buf_unref(fake.submitted[i]);
+	}
+}
+
+ZTEST(cdc_acm_suspend, test_full_tx_buffer_does_not_spin)
+{
+	memset(net_buf_add(uart_data.tx_fifo.current, BUFFER_SIZE), 'x', BUFFER_SIZE);
+	fake.tx_pending = 8U;
+	cdc_acm_irq_tx_enable(&uart_dev);
+	run_work();
+
+	zassert_equal(fake.work_count, 0, "Suspended TX keeps submitting callbacks");
+	zassert_equal(fake.tx_bytes, 0);
+	zassert_equal(fake.enqueued_in, 0);
+	zassert_equal(cdc_acm_tx_fifo_space_get(&uart_data), 0);
+}
+
+ZTEST(cdc_acm_suspend, test_suspended_tx_uses_remaining_tailroom)
+{
+	memset(net_buf_add(uart_data.tx_fifo.current, BUFFER_SIZE - 4U), 'x', BUFFER_SIZE - 4U);
+	fake.tx_pending = 8U;
+	cdc_acm_irq_tx_enable(&uart_dev);
+	run_work();
+
+	zassert_equal(fake.work_count, 0, "Suspended TX keeps submitting callbacks");
+	zassert_equal(fake.tx_bytes, 4);
+	zassert_equal(fake.tx_pending, 4);
+	zassert_equal(fake.enqueued_in, 0);
+	zassert_equal(uart_data.tx_fifo.current->len, BUFFER_SIZE);
+}
+
+ZTEST(cdc_acm_suspend, test_resume_restarts_pending_tx)
+{
+	net_buf_add_mem(uart_data.tx_fifo.current, "pending", 7);
+	cdc_acm_work_schedule(&uart_data.tx_fifo_work, K_NO_WAIT);
+	zassert_equal(run_work(), 1);
+	zassert_equal(fake.enqueued_in, 0);
+
+	usbd_cdc_acm_resumed(&class_data);
+	run_work();
+
+	zassert_equal(fake.enqueued_in, 1, "Resume did not restart buffered TX");
+	zassert_equal(fake.submitted[0]->len, 7);
+	zassert_mem_equal(fake.submitted[0]->data, "pending", 7);
+	zassert_equal(fake.work_count, 0);
+}
+
+ZTEST(cdc_acm_suspend, test_resume_rearms_rx)
+{
+	atomic_set_bit(&uart_data.state, CDC_ACM_IRQ_RX_ENABLED);
+	cdc_acm_work_submit(&uart_data.rx_fifo_work);
+	zassert_equal(run_work(), 1);
+	zassert_equal(fake.enqueued_out, 0);
+
+	usbd_cdc_acm_resumed(&class_data);
+	run_work();
+
+	zassert_equal(fake.enqueued_out, BUFFER_COUNT, "Resume did not rearm RX");
+	zassert_equal(fake.work_count, 0);
+}
+
+ZTEST(cdc_acm_suspend, test_resume_rearms_polling_rx)
+{
+	uart_data.cb = NULL;
+	cdc_acm_work_submit(&uart_data.rx_fifo_work);
+	zassert_equal(run_work(), 1);
+
+	usbd_cdc_acm_resumed(&class_data);
+	run_work();
+
+	zassert_equal(fake.enqueued_out, BUFFER_COUNT, "Resume did not rearm polling RX");
+	zassert_equal(fake.callbacks, 0);
+	zassert_equal(fake.work_count, 0);
+}
+
+ZTEST(cdc_acm_suspend, test_resume_keeps_irqs_disabled)
+{
+	net_buf_add_mem(uart_data.tx_fifo.current, "pending", 7);
+	usbd_cdc_acm_resumed(&class_data);
+	run_work();
+
+	zassert_equal(fake.enqueued_in, 1);
+	zassert_equal(fake.enqueued_out, 0);
+	zassert_equal(fake.callbacks, 0);
+	zassert_equal(fake.work_count, 0);
+}
+
+ZTEST(cdc_acm_suspend, test_resume_restarts_enabled_tx_irq)
+{
+	memset(net_buf_add(uart_data.tx_fifo.current, BUFFER_SIZE), 'x', BUFFER_SIZE);
+	fake.tx_pending = 8U;
+	cdc_acm_irq_tx_enable(&uart_dev);
+	run_work();
+
+	usbd_cdc_acm_resumed(&class_data);
+	run_work();
+
+	zassert_equal(fake.enqueued_in, 1);
+	zassert_equal(fake.tx_bytes, 8, "Resume did not restart the TX callback");
+	zassert_equal(fake.tx_pending, 0);
+	zassert_equal(fake.work_count, 0);
+}
+
+ZTEST(cdc_acm_suspend, test_resume_does_not_restart_disabled_class)
+{
+	atomic_set_bit(&uart_data.state, CDC_ACM_IRQ_RX_ENABLED);
+	atomic_set_bit(&uart_data.state, CDC_ACM_IRQ_TX_ENABLED);
+	usbd_cdc_acm_disable(&class_data);
+	usbd_cdc_acm_resumed(&class_data);
+
+	zassert_equal(fake.work_count, 0);
+	zassert_false(atomic_test_bit(&uart_data.state, CDC_ACM_CLASS_SUSPENDED));
+}
+
+ZTEST(cdc_acm_suspend, test_suspended_rx_can_drain_buffered_data)
+{
+	struct net_buf *buf = net_buf_alloc(&rx_pool, K_NO_WAIT);
+
+	zassert_not_null(buf);
+	net_buf_add_mem(buf, "data", 4);
+	k_fifo_put(&rx_bufs, buf);
+	cdc_acm_irq_rx_enable(&uart_dev);
+	run_work();
+
+	zassert_equal(fake.rx_bytes, 4);
+	zassert_equal(fake.enqueued_out, 0);
+	zassert_equal(fake.work_count, 0);
+}
+
+ZTEST_SUITE(cdc_acm_suspend, NULL, NULL, before, after, NULL);
